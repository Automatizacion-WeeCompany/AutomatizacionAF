{
  "name": "automatizacion-certificacion-pom",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Automatización Playwright FlexSalud",
  "scripts": {
    "test": "NODE_NO_WARNINGS=1 npx playwright test",
    "test:ui": "NODE_NO_WARNINGS=1 npx playwright test --ui",
    "test:headless": "CI=1 NODE_NO_WARNINGS=1 playwright test --project=Chromium",
    "test:ci": "CI=1 CI_PROFILE=smoke NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts",
    "test:ci:list": "CI=1 CI_PROFILE=smoke NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts --list",
    "test:ci:reglas": "CI=1 NODE_NO_WARNINGS=1 playwright test --config=playwright.rules.config.ts",
    "test:ci:reglas:list": "CI=1 NODE_NO_WARNINGS=1 playwright test --config=playwright.rules.config.ts --list",
    "test:ci:nightly": "CI=1 CI_PROFILE=nightly NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts",
    "test:ci:nightly:list": "CI=1 CI_PROFILE=nightly NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts --list",
    "test:ci:critical": "CI=1 CI_PROFILE=critical NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts",
    "test:ci:critical:list": "CI=1 CI_PROFILE=critical NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts --list",
    "test:ci:integration": "CI=1 CI_PROFILE=integration NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts",
    "test:ci:integration:list": "CI=1 CI_PROFILE=integration NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts --list",
    "test:ci:tarifas": "CI=1 CI_PROFILE=tarifas CI_TARIFA_ACOTADA=1 CI_TARIFA_MAX_PAISES=5 NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts",
    "test:ci:tarifas:list": "CI=1 CI_PROFILE=tarifas CI_TARIFA_ACOTADA=1 CI_TARIFA_MAX_PAISES=5 NODE_NO_WARNINGS=1 playwright test --config=playwright.ci.config.ts --list",
    "test:reglas": "NODE_NO_WARNINGS=1 playwright test src/tests/reglas --project=Chromium",
    "test:aplicacion": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion --project=Chromium",
    "test:aplicacion:emision": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion/emision-directa.spec.ts --project=Chromium",
    "test:aplicacion:uw-bmi": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion/revision-uw/bmi-titular.spec.ts --project=Chromium",
    "test:aplicacion:esp": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion --project=Chromium --grep \"@esp\"",
    "test:aplicacion:eng": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion --project=Chromium --grep \"@eng\"",
    "test:aplicacion:port": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion --project=Chromium --grep \"@port\"",
    "test:integracion:claims": "NODE_NO_WARNINGS=1 playwright test src/tests/integracion/weeclaims --project=Chromium",
    "test:tarifas": "NODE_NO_WARNINGS=1 playwright test src/tests/matriz-comercial/tarifas-por-pais.spec.ts",
    "test:tarifas:list": "NODE_NO_WARNINGS=1 playwright test src/tests/matriz-comercial/tarifas-por-pais.spec.ts --list",
    "test:flujo:bmi": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion/revision-uw/bmi-titular.spec.ts --project=Chromium --headed --grep \"póliza Individual.*Superior Ultra Anual \\| Eng\"",
    "test:flujo:bmi:esp": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion/revision-uw/bmi-titular.spec.ts --project=Chromium --headed --grep \"póliza Individual.*Superior Ultra Anual \\| Esp\"",
    "test:flujo:bmi:eng": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion/revision-uw/bmi-titular.spec.ts --project=Chromium --headed --grep \"póliza Individual.*Superior Ultra Anual \\| Eng\"",
    "test:flujo:bmi:port": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion/revision-uw/bmi-titular.spec.ts --project=Chromium --headed --grep \"póliza Individual.*Superior Ultra Anual \\| Port\"",
    "test:flujo:normal": "NODE_NO_WARNINGS=1 playwright test src/tests/aplicacion/emision-directa.spec.ts --project=Chromium --headed --grep \"póliza Individual.*Superior Ultra Anual \\| Esp\"",
    "clean": "rd /s /q dist && rd /s /q test-results && rd /s /q node_modules",
    "build": "npx tsc --noEmit",
    "merge-polizas": "ts-node src/utilidades/consolidarReportesPolizas.ts",
    "test:full": "playwright test && npm run merge-polizas",
    "test:e2e": "playwright test --config=src/configuraciones/playwright.config.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.45.0",
    "exceljs": "^4.4.0",
    "faker": "^6.6.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/xlsx": "^0.0.35",
    "typescript": "^5.4.0"
  }
}
